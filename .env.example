# Single shared password for the Crew Manifest (/crew). There is no username —
# this password alone grants access to view the roster and sign up for legs.
# Set this in your host environment in production. Rotating it (and restarting
# the server) immediately signs everyone out.
CREW_PASSWORD=change-me

# Optional: override the SQLite database location (defaults to ./data/crew.sqlite).
# Used only in local dev / on a host with a writable, persistent disk.
# CREW_DB_PATH=/var/data/crew.sqlite

# Production persistence (e.g. Vercel, whose filesystem is read-only): set BOTH
# of these to use Supabase/Postgres instead of the local SQLite file. When set,
# the app ignores CREW_DB_PATH. Run supabase/schema.sql once in your project
# first. The service-role key is SERVER-ONLY — never expose it / never prefix
# with NEXT_PUBLIC.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Deal-hunter cron (app/api/cron/deal-hunter) ──────────────────────────────
# Shared secret guarding the endpoint. Set the SAME value in two places:
#   1. Vercel env vars (so the route can check it)
#   2. GitHub repo → Settings → Secrets → Actions → CRON_SECRET (the scheduler
#      in .github/workflows/deal-hunter.yml sends it as a Bearer token)
# Any long random string works — generate one with: openssl rand -hex 32
# CRON_SECRET=your-long-random-string

# Serper.dev API key (serper.dev) for Google Shopping price checks.
# Free: 2,500 credits on signup. Then $0.30/1,000 queries — 18 items × 52 weeks
# costs about $0.28/year after the free credits are spent.
# SERPER_API_KEY=your-serper-key

# Resend (resend.com) for email alerts. Free: 3 000 emails/month.
# After signing up, verify a sending domain and replace the `from` address in
# lib/cron/notify.ts.
# RESEND_API_KEY=re_your-key
# DEAL_ALERT_TO=your@email.com
